// Let the pireplace service user manage Wi-Fi through NetworkManager without a
// desktop session: only the actions the hotspot watcher and setup page need.
// Everything else, and every other user, falls through to the default policy.
var PIREPLACE_NM_ACTIONS = [
    "org.freedesktop.NetworkManager.network-control",
    "org.freedesktop.NetworkManager.settings.modify.system",
    "org.freedesktop.NetworkManager.wifi.scan",
    "org.freedesktop.NetworkManager.wifi.share.protected",
    "org.freedesktop.NetworkManager.wifi.share.open"
];

polkit.addRule(function(action, subject) {
    if (subject.user === "pireplace" && PIREPLACE_NM_ACTIONS.indexOf(action.id) !== -1) {
        return polkit.Result.YES;
    }
});
