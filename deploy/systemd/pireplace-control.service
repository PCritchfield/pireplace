[Unit]
Description=pireplace control page
After=network.target

[Service]
Type=simple
User=pireplace
Group=pireplace
WorkingDirectory=/opt/pireplace
Environment=PYTHONPATH=/opt/pireplace
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m pireplace serve --config /etc/pireplace/config.toml
Restart=always
RestartSec=2
# Exit status 2 means the config is invalid; restarting cannot fix that.
RestartPreventExitStatus=2

# Shared with pireplace-wifi.service: state.json, wifi-scan.json, wifi-connecting.
StateDirectory=pireplace
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# /run/pireplace holds the mpv sockets and the boot-done marker (tmpfs, cleared on reboot)
# that tells a fresh boot from a controller restart. Created by tmpfiles.d/pireplace.conf.
ReadWritePaths=-/run/pireplace

# Hardening. Network and AF_UNIX stay open: port 80, the mpv sockets in /run/pireplace,
# and the system D-Bus (nmcli, for the Wi-Fi setup page).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
