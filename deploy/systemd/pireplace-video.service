[Unit]
Description=pireplace fire video player (mpv)
After=pipewire.service wireplumber.service
Wants=pipewire.service
# Installed in /etc/systemd/user; only the pireplace user's manager may run it.
ConditionUser=pireplace
# Never stop restarting, however often it fails (the default gives up after 5 starts in 10 s).
StartLimitIntervalSec=0

[Service]
# User unit of the pireplace user. Sandboxing beyond NoNewPrivileges is left out on
# purpose: mpv needs /dev/dri and the user's PipeWire, and ProtectSystem/PrivateTmp
# depend on user namespaces that a user manager may not have.
Type=simple
NoNewPrivileges=yes
# The video folder is on the command line so the fire plays even if the controller is down;
# the controller then only applies volume/mute (and reloads after a rescan).
# --volume=40 matches the default log_volume, so after a restart or boot the fire sound
# starts at that level instead of mpv's 100% until the controller applies the saved volume.
ExecStart=/usr/bin/mpv --volume=40 --vo=gpu --gpu-context=drm --hwdec=auto-safe --fullscreen --idle=yes --loop-playlist=inf --no-osc --osd-level=0 --no-input-default-bindings --input-ipc-server=/run/pireplace/video.sock --really-quiet /srv/pireplace/videos
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
