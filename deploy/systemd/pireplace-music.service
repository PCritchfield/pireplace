[Unit]
Description=pireplace background music player (mpv)
After=pipewire.service wireplumber.service
Wants=pipewire.service
# Installed in /etc/systemd/user; only the pireplace user's manager may run it.
ConditionUser=pireplace
# Never stop restarting, however often it fails (the default gives up after 5 starts in 10 s).
StartLimitIntervalSec=0

[Service]
# User unit of the pireplace user; needs the user's PipeWire session. See the video unit
# for why sandboxing is limited to NoNewPrivileges.
Type=simple
NoNewPrivileges=yes
ExecStart=/usr/bin/mpv --no-video --idle=yes --loop-playlist=inf --input-ipc-server=/run/pireplace/music.sock --really-quiet
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
